{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "plugins": [
    "sqlite-database-integration"
  ],
  "login": true,
  "siteOptions": {
    "blogname": "SakhtYar Flow",
    "blogdescription": "پلتفرم هوشمند تحلیل، توسعه و مدیریت پروژه‌های ساختمانی"
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_LOG": true,
        "WP_DEBUG_DISPLAY": true
      }
    },
    {
      "step": "activateTheme",
      "themeFolderName": "sakhtyar-flow"
    },
    {
      "step": "activatePlugin",
      "pluginPath": "/wordpress/wp-content/plugins/sakhtyar-core"
    }
  ]
}